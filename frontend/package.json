{
  "name": "sfrontend",
"version": "2025.6-dev",
  "license": "MIT",
  "environments": {
    "dev": "environments/environment.ts",
    "prod": "environments/environment.prod.ts",
    "sandbox": "environments/environment.sandbox.ts",
    "tst": "environments/environment.tst.ts",
    "demo": "environments/environment.demo.ts",
    "kendartsbx": "environments/environment.kendartsbx.ts"
  },
  "publishConfig": {
    "registry": "https://artifacts.kendart-systems.com/repository/npm-releases/"
  },
  "scripts": {
    "ng": "ng",
    "ngcc": "ngcc",
    "start:dev": "node ./update-timestamp.js && ng serve -c development",
    "start:sandbox": "node ./update-timestamp.js && ng serve -c sandbox",
    "start:tst": "node ./update-timestamp.js && ng serve -c tst",
    "build:kendartsbx": "node ./update-timestamp.js && ng build -c kendartsbx --base-href / --output-path=public",
    "start:kendartsbx": "node ./update-timestamp.js && ng serve -c kendartsbx",
    "start": "npm run start:sandbox",
    "build": "ng build --base-href /",
    "build:lb-services": "./node_modules/.bin/lb-sdk ./../newbackend/server/server src/app/shared/sdk -d ng2web -i enabled",
    "build:prod": "node ./update-timestamp.js && ng build -c production --base-href / --output-path=public",
    "build:tst-build": "node ./update-timestamp.js && ng build -c tst --base-href / --output-path=builds/tst-build/public",
    "build:dev-build": "node ./update-timestamp.js && ng build -c sandbox --base-href / --output-path=builds/dev-build/public",
    "build:sandbox-build": "node ./update-timestamp.js && ng build -c sandbox --base-href / --output-path=builds/sandbox-build/public",
    "build:production-build": "node ./update-timestamp.js && ng build -c production --base-href / --output-path=builds/production-build/public",
    "build:demo-build": "node ./update-timestamp.js && ng build -c demo --base-href / --output-path=builds/demo-build/public",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": false,
